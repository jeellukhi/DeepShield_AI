MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=deepshield_ai
CORS_ORIGINS=http://localhost:5173
APP_ENV=development

# JWT auth settings
AUTH_JWT_SECRET=deepshield-dev-secret-change-in-production
AUTH_ACCESS_TOKEN_MINUTES=720
AUTH_REFRESH_TOKEN_DAYS=14
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AUTH_USER_USERNAME=user
AUTH_USER_PASSWORD=CHANGE_ME_USER_PASSWORD
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=900
