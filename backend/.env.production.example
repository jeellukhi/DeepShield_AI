APP_ENV=production
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=deepshield_ai

# Replace with your deployed frontend URL(s), comma-separated if multiple.
# Example:
# CORS_ORIGINS=https://deepshield-ai.vercel.app
CORS_ORIGINS=https://deepshield.ai.com

# JWT auth settings
AUTH_JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_32CHARS_MIN
AUTH_ACCESS_TOKEN_MINUTES=720
AUTH_REFRESH_TOKEN_DAYS=14
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AUTH_USER_USERNAME=user
AUTH_USER_PASSWORD=CHANGE_ME_USER_PASSWORD
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=900
